# Copy to .env.testing (gitignored), then:
#
#   php artisan key:generate --env=testing
#   php artisan test -c phpunit.mysql.xml
#
# THE -c IS NOT OPTIONAL
#
# This file alone does NOT move the suite onto MySQL. phpunit.xml pins
# DB_CONNECTION=sqlite, PHPUnit applies its <env> entries before Laravel boots,
# and Laravel's dotenv will not overwrite a variable that already exists. So
# `php artisan test` keeps using in-memory SQLite no matter what is set here:
# green, fast, and proving nothing about production. phpunit.mysql.xml exists
# to leave those keys unset so this file can decide. Measured, after being
# caught by exactly this.
#
# WHY THIS FILE IS A FULL COPY OF .env.example
#
# Laravel loads .env.testing INSTEAD OF .env when APP_ENV=testing, which both
# phpunit configs set. It does not layer on top. A file holding only the DB_*
# lines unsets everything else -- measured: 88 of the 111 tests then fail with
# "No application encryption key has been specified", because APP_KEY lived in
# .env and is no longer loaded. Hence the key:generate --env=testing above,
# which needs the blank APP_KEY= line below to write into.
#
# WHY RUN THE SUITE ON MySQL AT ALL
#
# Production is MariaDB; the SQLite default agrees with it on nothing it is not
# forced to. These migrations declare 28 `enum` and 10 `json` columns: on MySQL
# an enum is a real ENUM that rejects an unlisted value, while on SQLite it is
# a varchar that accepts anything. A test asserting the database refuses bad
# data can pass on SQLite while proving nothing.
#
# Must be a THROWAWAY database -- the suite migrates it from scratch.
# The DB_* defaults match the local devstack, which serves MySQL on
# 127.0.0.1:3307.

APP_NAME="Education Accountability Platform"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true   # a failing test should say why
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Hostinger MySQL — get these from hPanel > Databases > MySQL Databases.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=edu_test
DB_USERNAME=kesari
DB_PASSWORD=devstack-local-only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=array   # never send mail from a test run
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@edutest.agtci.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
